# =====================================================================
# Painel de Agentes — configuração
# Copie para .env (ou rode `make setup`, que já gera as chaves).
# NUNCA coloque o arquivo .env no git.
# =====================================================================

# --- Geral -------------------------------------------------------------
# development | production
APP_ENV=development

# Modo simulação: dados falsos e NENHUMA chamada de escrita real.
# Deixe "true" até o dono da loja decidir ligar o modo real.
DRY_RUN=true

# Fuso horário usado para "hoje", relatórios e agendamentos.
TIMEZONE=America/Sao_Paulo

# --- Segurança ---------------------------------------------------------
# Chave para assinar o cookie de sessão. Gere com: make keys
SECRET_KEY=
# Chave Fernet para criptografar os tokens OAuth no banco. Gere com: make keys
# ATENÇÃO: se perder esta chave, será preciso reconectar as contas.
ENCRYPTION_KEY=
# true em produção (HTTPS). Em desenvolvimento local (http) use false.
SESSION_COOKIE_SECURE=false
# Tempo de sessão do painel, em horas.
SESSION_MAX_AGE_HOURS=12
# Tentativas de login erradas antes de bloquear, e minutos de bloqueio.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Banco de dados ----------------------------------------------------
# Desenvolvimento: SQLite. Produção: postgresql+psycopg://usuario:senha@db:5432/painel
DATABASE_URL=sqlite:///./data/painel.db

# --- Olist ERP (API v3) — somente leitura --------------------------------
# Chaves do aplicativo criado no Olist (Menu > Configurações > Geral > Aplicativos).
# O painel só LÊ do Olist: nunca altera estoque, pedidos ou notas fiscais.
OLIST_CLIENT_ID=
OLIST_CLIENT_SECRET=
# Precisa ser IGUAL à "URL de redirecionamento" cadastrada no aplicativo do Olist.
OLIST_REDIRECT_URI=http://localhost:8000/integracoes/olist/retorno
# De quantos em quantos minutos buscar novidades no Olist.
OLIST_SYNC_MINUTES=10
# Na primeira conexão, quantos dias de pedidos e notas para trás importar.
OLIST_INITIAL_DAYS=15

# --- Mercado Livre (API oficial) -----------------------------------------
# Chaves do aplicativo criado em developers.mercadolivre.com.br/devcenter.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Precisa ser IGUAL à "URI de redirect" do aplicativo. O Mercado Livre exige
# HTTPS público, por isso usamos a página de repasse no GitHub Pages, que
# devolve o login para o painel em http://localhost:8000.
ML_REDIRECT_URI=https://alyssonov.github.io/painel-retorno/mercadolivre/
# De quantos em quantos minutos buscar perguntas, reputação e taxas.
ML_SYNC_MINUTES=5

# --- IA (Claude API) ------------------------------------------------------
# Chave criada em console.anthropic.com > API Keys. Coloque também um limite
# de gasto mensal no Console (Billing) como segunda trava.
ANTHROPIC_API_KEY=
# Teto de gasto diário com IA, em reais. Ao atingir, os agentes de IA pausam.
AI_DAILY_BUDGET_BRL=10
# Cotação do dólar usada só para ESTIMAR o gasto em reais no painel.
USD_BRL_RATE=5.50
# De quantos em quantos minutos o Respondedor de perguntas olha a fila.
AGENT_QUESTIONS_MINUTES=3
